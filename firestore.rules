rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /leaderboardIndonesia/{uid} {
      allow read: if true;
      allow write: if false;
    }
    match /leaderboardIndonesiaWeekly/{entryId} {
      allow read: if true;
      allow write: if false;
    }
    match /leaderboardIndonesiaMonthly/{entryId} {
      allow read: if true;
      allow write: if false;
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}